{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{codedna/**,work/evaluation/results.json}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py?__route=api/:path*" },
    { "source": "/", "destination": "/api/index.py?__route=root" },
    { "source": "/analyze.html", "destination": "/api/index.py?__route=analyze.html" },
    { "source": "/evidence.html", "destination": "/api/index.py?__route=evidence.html" },
    { "source": "/:asset(styles.css|app.js|site.js|evidence.js)", "destination": "/api/index.py?__route=:asset" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
